#!/usr/bin/env bash
set -Eeuo pipefail

# This runs only in a VM with a serial port. The CI runner reads the
# unambiguous PASS/FAIL markers directly from QEMU's serial output.
exec > /dev/ttyS0 2>&1
trap 'result=$?; echo "KOVA_CI_FAIL (exit $result, line $LINENO): $BASH_COMMAND"; exit "$result"' ERR

echo "KOVA_CI_BEGIN"

test "$(cat /etc/hostname)" = "kova"
. /etc/os-release
test "$ID" = "kova"
test "$ID_LIKE" = "arch"
test "$PRETTY_NAME" = "Kova Linux"
# Verify that ordinary command lookup selects the Rust replacements, while
# the package-owned GNU implementations are left available in /usr/bin.
for cmd in grep find xargs; do
  test -x "/usr/local/bin/$cmd"
  test "$(command -v "$cmd")" = "/usr/local/bin/$cmd"
done
tmp=$(mktemp -d)
printf 'rust is the default\n' > "$tmp/check.txt"
grep -q 'rust is the default' "$tmp/check.txt"
test "$(find "$tmp" -type f -name check.txt)" = "$tmp/check.txt"
printf '%s\n' "$tmp/check.txt" | xargs grep -q 'rust is the default'
rm -rf "$tmp"

test "$(getent passwd kova | cut -d: -f7)" = "/usr/bin/fish"
test -f /home/kova/.config/nvim/init.lua
test -f /home/kova/.config/nvim/lazy-lock.json
id -nG kova | tr ' ' '\n' | grep -qx wheel
systemctl is-active --quiet kova-live-user.service
systemctl cat getty@tty1.service | grep -q -- '--autologin kova'

for cmd in fish nvim rg fd eza btm dust procs dysk sd pacman git; do
  command -v "$cmd" >/dev/null
done

# Test the actual live user rather than executing everything as root.
runuser -u kova -- fish -c 'type -q tide'
# Verify interactive Fish defaults and exercise the Rust-backed file tools.
runuser -u kova -- env TERM=dumb fish -ic '
  functions -q ls ll la cat cp mv rm mkdir touch sort wc du ps df; or exit 1
  set -l tmp (command mktemp -d)
  or exit 1
  echo kova > $tmp/original
  cp $tmp/original $tmp/copied; or exit 1
  mv $tmp/copied $tmp/moved; or exit 1
  test (cat $tmp/moved) = kova; or exit 1
  rm $tmp/moved; or exit 1
  test ! -e $tmp/moved; or exit 1
  command rm -r $tmp
' </dev/null
runuser -u kova -- nvim --headless --clean +qall!
runuser -u kova -- sudo -n true

echo "KOVA_CI_PASS"
