#!/usr/bin/env bash
set -Eeuo pipefail

# Never share ttyS0 with serial-getty: systemd starts a serial login there.
# Instead, send CI markers through the kernel log, which is also written to
# the QEMU serial console via the Archiso console=ttyS0 kernel argument.
exec 3>/dev/kmsg
stage="startup"
log() {
  printf '<5>%s\n' "$*" >&3
}
on_exit() {
  local rc=$?
  trap - EXIT
  if (( rc == 0 )); then
    log "KOVA_CI_PASS"
  else
    log "KOVA_CI_FAIL exit=$rc stage=$stage"
  fi
}
trap on_exit EXIT
log "KOVA_CI_BEGIN"

stage="live identity and release"
test "$(/usr/bin/cat /etc/hostname)" = "kova"
. /etc/os-release
test "$ID" = "kova"
test "$ID_LIKE" = "arch"
test "$PRETTY_NAME" = "Kova Linux"
log "KOVA_CI_STEP identity passed"

stage="Rust grep/find/xargs binaries"
for cmd in grep find xargs; do
  test -x "/usr/local/bin/$cmd"
  test "$(command -v "$cmd")" = "/usr/local/bin/$cmd"
done
tmp=$(mktemp -d)
printf 'rust is the default\n' > "$tmp/check.txt"
grep -q 'rust is the default' "$tmp/check.txt"
test "$(find "$tmp" -type f -name check.txt)" = "$tmp/check.txt"
printf '%s\n' "$tmp/check.txt" | xargs grep -q 'rust is the default'
rm -rf "$tmp"
log "KOVA_CI_STEP rust-search passed"

stage="live account and autologin"
test "$(getent passwd kova | cut -d: -f7)" = "/usr/bin/fish"
test -f /home/kova/.config/nvim/init.lua
test -f /home/kova/.config/nvim/lazy-lock.json
id -nG kova | tr ' ' '\n' | grep -qx wheel
systemctl is-active --quiet kova-live-user.service
systemctl cat getty@tty1.service | grep -q -- '--autologin kova'
log "KOVA_CI_STEP live-account passed"

stage="automatic mirror refresh configuration"
command -v rate-mirrors >/dev/null
test -x /usr/local/lib/kova/update-mirrors
systemctl is-enabled --quiet kova-mirrors.timer
log "KOVA_CI_STEP mirrors passed"

stage="Rust Kova installer preview"
test -x /usr/local/bin/kova
/usr/local/bin/kova install --dry-run --demo | /usr/bin/grep -q 'NO PARTITIONS OR FILES WERE MODIFIED'
/usr/local/bin/kova install --list-disks >/dev/null
test -x /usr/local/lib/kova/install-system
test -x /usr/local/bin/anvil
test -x /usr/local/bin/anvilctl
test -x /usr/local/bin/kova-session
test -f /etc/greetd/config.toml
test -f /etc/skel/.config/anvil/config.toml
test -f /etc/skel/.config/mako/config
test -f /etc/skel/.config/alacritty/alacritty.toml
test -f /etc/fonts/conf.d/70-kova-monospace.conf
for pkg in alacritty ttf-jetbrains-mono ttf-nerd-fonts-symbols-mono adwaita-icon-theme; do
  pacman -Q "$pkg" >/dev/null
done
command -v alacritty >/dev/null
fc-match -f '%{family}\n' monospace | /usr/bin/grep -Fq 'JetBrains Mono'
test -f /usr/share/icons/Adwaita/symbolic/status/audio-volume-muted-symbolic.svg
/usr/bin/grep -Fqx 'terminal = "alacritty"' /etc/skel/.config/anvil/config.toml
/usr/bin/grep -Fqx 'volume_up = "kova-osd volume up"' /etc/skel/.config/anvil/config.toml
/usr/bin/grep -Fqx 'brightness_down = "kova-osd brightness down"' /etc/skel/.config/anvil/config.toml
test -x /usr/local/bin/kova-osd
/usr/local/bin/kova-osd --help | /usr/bin/grep -q 'kova-osd volume'
/usr/bin/grep -q '"mako"' /etc/skel/.config/anvil/config.toml
for cmd in mako notify-send wpctl brightnessctl; do command -v "$cmd" >/dev/null; done
test -n "$(find /var/lib/kova/wallpapers/files -type f -name '*.png' -print -quit)"
/usr/local/bin/kova news --summary >/dev/null
log "KOVA_CI_STEP installer-preview passed"

stage="available CLI tools"
for cmd in kova fish nvim rg fd eza btm dust procs dysk sd pacman git; do
  command -v "$cmd" >/dev/null
done
log "KOVA_CI_STEP cli-tools passed"

stage="Tide as kova user"
runuser -u kova -- fish -c 'type -q tide'
log "KOVA_CI_STEP tide passed"

stage="interactive Fish Rust defaults"
runuser -u kova -- env TERM=dumb fish -ic '
  functions -q ls ll la cat cp mv rm mkdir touch sort wc du ps df; or exit 1
  set -l tmp (command mktemp -d)
  or exit 1
  echo kova > $tmp/original
  cp $tmp/original $tmp/copied; or exit 1
  mv $tmp/copied $tmp/moved; or exit 1
  test (cat $tmp/moved) = kova; or exit 1
  rm $tmp/moved; or exit 1
  test ! -e $tmp/moved; or exit 1
  command rm -r $tmp
' </dev/null
log "KOVA_CI_STEP fish-file-operations passed"

stage="Neovim startup"
runuser -u kova -- nvim --headless --clean +qall!
log "KOVA_CI_STEP neovim passed"

stage="passwordless sudo as kova"
# Assert that sudo actually runs as root; no reliance on a silent 'true'.
test "$(runuser -u kova -- /usr/bin/sudo -n /usr/bin/id -u)" = "0"
log "KOVA_CI_STEP sudo passed"
