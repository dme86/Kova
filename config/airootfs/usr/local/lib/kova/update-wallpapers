#!/usr/bin/env bash
set -Eeuo pipefail
repo=/var/lib/kova/wallpapers
[[ -d "$repo/.git" ]] || exit 1
# Shared, root-owned copy: never mutate individual user configuration.
git -C "$repo" fetch --depth 1 origin main
git -C "$repo" reset --hard FETCH_HEAD
test -n "$(find "$repo/files" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) -print -quit)"
echo "Kova wallpapers updated to $(git -C "$repo" rev-parse --short HEAD)"
