#!/usr/bin/env bash
set -Eeuo pipefail
# Anvil starts this after the Wayland socket exists.
# Always retain the three offline seed images; also include up to five
# downloaded images without following temporary/staging directories.
root=/var/lib/kova/wallpapers
[[ -n ${WAYLAND_DISPLAY:-} && -d "$root/files" ]] || exit 0
dirs=("$root/files")
[[ -d "$root/cache" ]] && dirs+=("$root/cache")
picked=$(find "${dirs[@]}" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) | shuf -n1)
[[ -n "$picked" ]] || exit 0
exec swaybg --image "$picked" --mode fill
